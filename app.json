{
  "expo": {
    "name": "Golf Tracker",
    "slug": "golf-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "golftracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.miapp.golftracker",
      "config": {
        "googleMapsApiKey": "YOUR_IOS_MAPS_API_KEY"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para mostrar distancias al hoyo y medir la distancia de tus golpes.",
        "NSCameraUsageDescription": "ShotVision necesita la cámara para grabar tus swings a alta velocidad.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.miapp.golftracker",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrar distancias al hoyo y medir tus golpes."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a472a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ShotVision necesita acceso a tus vídeos para calibrar la posición de la cámara."
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "ShotVision necesita la cámara para grabar tus swings a alta velocidad.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55fce35b-0752-472f-b2f2-ccb5193a9164"
      }
    },
    "owner": "mqmf"
  }
}
